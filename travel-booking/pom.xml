<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>org.bp</groupId>
    <artifactId>travel</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>travel-booking</name>
    <description>travel-booking</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-spring-boot-starter</artifactId>
            <version>4.22.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>


            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>4.0.16</version>

                <executions>
                    <execution>
                        <id>generate-flight</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaLanguage>WSDL</schemaLanguage>
                            <generatePackage>org.bp.flight</generatePackage>

                            <schemaDirectory>
                                ${project.basedir}/src/main/resources
                            </schemaDirectory>

                            <schemaIncludes>
                                <include>flight.wsdl</include>
                            </schemaIncludes>

                            <generateDirectory>
                                ${project.build.directory}/generated-sources/jaxb/flight
                            </generateDirectory>
                            <bindingDirectory>
                                ${project.basedir}/src/main/resources
                            </bindingDirectory>
                            <bindingIncludes>
                                <include>flight.xjb</include>
                            </bindingIncludes>
                        </configuration>
                    </execution>
<!--
                    <execution>
                        <id>generate-hotel-booking</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaLanguage>WSDL</schemaLanguage>
                            <generatePackage>org.bp.payment</generatePackage>

                            <schemaDirectory>
                                ${project.basedir}/src/main/resources
                            </schemaDirectory>

                            <schemaIncludes>
                                <include>HotelBooking.wsdl</include>
                            </schemaIncludes>

                            <generateDirectory>
                                ${project.build.directory}/generated-sources/jaxb/hotel-booking
                            </generateDirectory>
                        </configuration>
                    </execution>
                    -->
                </executions>
            </plugin>


        </plugins>
    </build>

</project>
